cd /workspace && if [ -f AGENTS.md ]; then cat AGENTS.md; fi; for p in /shared/AGENTS.md /shared/competition/AGENTS.md /shared/competition/daily_fade2130e2e5_m1/AGENTS.md /shared/competition/daily_fade2130e2e5_m1/round-1/AGENTS.md /shared/competition/daily_fade2130e2e5_m1/round-1/agent-one/AGENTS.md; do if [ -f "$p" ]; then printf '\n--- %s ---\n' "$p"; cat "$p"; fi; done; printf '\n--- brief ---\n'; cat /shared/competition/daily_fade2130e2e5_m1/round-1/brief.md; printf '\n--- previous evidence ---\n'; cat /shared/competition/daily_fade2130e2e5_m1/round-0/evidence.md; printf '\n--- previous learning ---\n'; cat /shared/competition/daily_fade2130e2e5_m1/round-0/learning.json; printf '\n--- bars ---\n'; cat /shared/competition/daily_fade2130e2e5_m1/round-1/bars.csv; printf '\n--- own retained sources ---\n'; find /workspace -maxdepth 3 -type f \( -name '*strategy*' -o -name '*round*' -o -name '*manifest*' \) -not -path '*/.git/*' -print