cabal-version: 2.4
name: agent-one
version: 0.1.0.0
license: MIT
license-file: LICENSE
build-type: Simple

executable agent-one
  main-is: Main.hs
  other-modules: A2ACompat, ExecutionRuntime, A2A, RequestGate, StepLoader, ContextWindow, ModelConnection, ChatGPTAuth, ResponseStream
  hs-source-dirs: app src
  default-language: Haskell2010
  default-extensions: OverloadedStrings ScopedTypeVariables
  ghc-options: -O2 -dynamic -threaded -rtsopts
  build-depends:
    base >=4.18 && <5,
    aeson,
    async,
    bytestring,
    containers,
    directory,
    filepath,
    cryptonite,
    memory,
    network,
    hint,
    process,
    stm,
    text,
    time,
    unix,
    vector
