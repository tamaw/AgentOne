LLM_AUTH=foundry
LLM_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
LLM_API_KEY=your-foundry-resource-api-key
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=900

# For ChatGPT plan usage, set LLM_AUTH=chatgpt and sign in with agent-one auth login.
# Foundry endpoint and API key are not used in chatgpt mode.
